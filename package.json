{
  "name": "local-8-ball-pool",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:client\" \"npm:dev:server\"",
    "dev:client": "vite --host 0.0.0.0 --port 5173",
    "dev:server": "node server/index.js",
    "build": "vite build",
