    "start": "node server/index.js",
    "test": "vitest run"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "vite": "^8.3.0",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "express": "^5.2.1",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4"
  }
}
